<Window x:Class="SistemaDelivery.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yummy - login" Width="960" Height="600" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextBrush}" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

    
        <Grid Grid.Column="0">
            <Image Source="/View/Assets/bg.jpg"/>
        </Grid>

        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

                <Image Source="/View/Assets/logo2.png" Height="69" Width="150" Margin="0,0,0,46"/>

                <TextBlock Text="CPF" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                <TextBox x:Name="txtCpf" Style="{StaticResource LineTextBox}" MaxLength="14" Margin="0,2,0,26"/>

                <TextBlock Text="Senha" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                <Grid Margin="0,2,0,0">
                    <PasswordBox x:Name="pwdSenha" Style="{StaticResource LinePasswordBox}" Padding="0,6,30,6"/>
                    <TextBox x:Name="txtSenhaVisivel" Style="{StaticResource LineTextBox}" Padding="0,6,30,6"
                             Visibility="Collapsed"/>
                    <ToggleButton x:Name="tglSenha" Style="{StaticResource GhostToggle}" Content="&#xE7B3;"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  ToolTip="Mostrar/ocultar senha" Click="MostrarSenha_Click"/>
                </Grid>

                <TextBlock x:Name="txtErro" Foreground="{StaticResource DangerBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                <Button x:Name="btnEntrar" Content="Entrar" IsDefault="True" Click="Entrar_Click"
                        Style="{StaticResource PillButton}" Height="36" Width="124" Margin="0,30,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
